# This is an example file. For local development, you can copy this file
# to a new file named `.env` and fill in the actual values.
# The `.env` file is ignored by Git and should never be committed.

# ===============================
# DATABASE CONFIGURATION
# ===============================
DB_URL=jdbc:postgresql://localhost:5432/Sehaty
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# ===============================
# CLOUDINARY CONFIGURATION
# ===============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===============================
# SECURITY CONFIGURATION
# ===============================
# A long, random string used to sign JWTs.
JWT_SECRET=your_very_long_and_secure_jwt_secret_key

# Must be exactly 16 characters (for AES-128).
ENCRYPTION_KEY=your_16_char_encryption_key

# ===============================
# APPLICATION CONFIGURATION
# ===============================
FRONTEND_URL=http://localhost:8089
